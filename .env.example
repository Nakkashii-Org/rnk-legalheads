# true = show unapproved content and layout previews (review only). Leave unset in production.
SHOW_DRAFT_CONTENT=

# Canonical production URL, used for metadata and canonical links.
PUBLIC_SITE_URL=

# rnk-legalhead-backend address (server-only, never NEXT_PUBLIC_). /api/* is forwarded here.
# Read at build time: set it before `npm run build`. Local: http://localhost:4000
BACKEND_URL=

# Shared secret with rnk-legalhead-backend (same value on both). Lets draft review mode read draft
# content from the backend. Server-only; at least 24 random characters. Leave empty in production
# once content is approved and draft mode is off.
CONTENT_PREVIEW_SECRET=
